using Toybox.WatchUi;
using Toybox.Graphics;
using Toybox.System;
using Toybox.Lang;
using Toybox.ActivityMonitor;

class MyWatchFaceView extends WatchUi.WatchFace {

    function initialize() {
        WatchFace.initialize();
    }

    function onUpdate(dc) {
        dc.setColor(Graphics.COLOR_BLACK, Graphics.COLOR_BLACK);
        dc.clear();

        var width = dc.getWidth();
        var height = dc.getHeight();

        dc.setColor(Graphics.COLOR_WHITE, Graphics.COLOR_TRANSPARENT);

        var sysStats = System.getSystemStats();
        var battery = sysStats.battery;
        var batteryString = "BAT: " + battery.format("%d") + "%";

        dc.drawText(
            width / 2, 
            15, 
            Graphics.FONT_XTINY, 
            batteryString, 
            Graphics.TEXT_JUSTIFY_CENTER
        );

        var clockTime = System.getClockTime();
        var timeString = Lang.format("$1$:$2$", [
            clockTime.hour.format("%02d"),
            clockTime.min.format("%02d")
        ]);

        dc.drawText(
            width / 2, 
            (height / 2) - 20, 
            Graphics.FONT_LARGE, 
            timeString, 
            Graphics.TEXT_JUSTIFY_CENTER
        );

        var info = ActivityMonitor.getInfo();
        var steps = 0;
        if (info != null && info.steps != null) {
            steps = info.steps;
        }

        var stepString = "STEPS: " + steps.toString();

        dc.drawText(
            width / 2, 
            (height / 2) + 20, 
            Graphics.FONT_SMALL, 
            stepString, 
            Graphics.TEXT_JUSTIFY_CENTER
        );
    }
}

class MyWatchFaceApp extends Toybox.Application.AppBase {
    function initialize() {
        AppBase.initialize();
    }

    function getInitialView() {
        return [ new MyWatchFaceView() ];
    }
}

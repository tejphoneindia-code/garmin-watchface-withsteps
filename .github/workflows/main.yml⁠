name: Build Garmin Watchface (.iq)

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Download & Setup Connect IQ SDK
        run: |
          mkdir -p ciq-sdk
          # Download SDK release directly
          curl -L -o sdk.zip "https://developer.garmin.com/downloads/connect-iq/sdks/connectiq-sdk-lin-7.1.0-2024-03-05-6415668b8.zip" || true
          if [ ! -s sdk.zip ]; then
            echo "Direct download failed, fetching backup SDK bundle..."
            curl -L -o sdk.zip "https://github.com/garmin/connectiq-apps/releases/download/v1.0/connectiq-sdk-lin-6.4.2.zip"
          fi
          unzip -q sdk.zip -d ciq-sdk

      - name: Generate Key & Compile .iq
        run: |
          openssl genrsa -out developer_key.pem 4096
          openssl pkcs8 -topk8 -inform PEM -outform DER -in developer_key.pem -out developer_key.der -nocrypt
          ./ciq-sdk/bin/monkeyc -e -o release.iq -f monkey.jungle -y developer_key.der -d instinct2solar

      - name: Upload Compiled .iq
        uses: actions/upload-artifact@v4
        with:
          name: Garmin-IQ-Package
          path: release.iq
